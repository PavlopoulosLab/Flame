# Flame 3.0 — Docker Compose configuration
#
# Copy this file to ".env" (which is gitignored) and uncomment/edit whatever
# you need to change. Anything left commented out, or missing entirely, uses
# the default shown here — see docker-compose.yml and README.md for details.

# Host port Flame is reachable on (container always listens on FLAME_PORT).
# FLAME_HTTP_PORT=8000

# Port the app listens on inside the container.
# FLAME_PORT=8000

# SQLite workspace database path inside the container (/data is the volume).
# FLAME_DB=/data/flame.sqlite

# Background enrichment workers (mirai daemons); capped at the host's core count.
# FLAME_WORKERS=4

# Delete workspaces after this many days without use.
# FLAME_RETENTION_DAYS=30

# Lists per workspace (0 = unlimited).
# FLAME_MAX_LISTS=10

# New workspaces per hour per client address (0 = no limit).
# FLAME_WORKSPACE_LIMIT=30

# API requests per minute per client address (0 = no limit, e.g. for local testing).
# FLAME_RATE_LIMIT=600

# Public base URL, used in links and emails (e.g. https://flame.example.org).
# FLAME_PUBLIC_URL=

# NCBI E-utilities API key for the PubMed and dbSNP inputs (10 instead of 3
# requests per second); recommended for public servers.
# FLAME_NCBI_API_KEY=

# Optional "results ready" emails: SMTP server URL and From address.
# FLAME_SMTP_URL=smtps://user:password@smtp.example.org:465
# FLAME_SMTP_FROM=flame@example.org
